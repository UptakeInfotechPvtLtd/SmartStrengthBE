#@app
APP_ENV=development
APP_NAME=action-arena-gamezone-api
APP_TIMEZONE=Asia/Kolkata

#BACKEND
BACKEND_PROTOCOL=http
BACKEND_HOST=localhost
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000

#FRONTEND
FRONTEND_URL=http://localhost:5173

# Database configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=ActionArenaGamezone
DB_LOG_LEVEL="simple-console" #"advanced-console" | "simple-console" | "file" | "debug"

# Redis configuration
REDIS_URL=redis://localhost:6379

# RabbitMQ configuration
RABBITMQ_ENABLED=1
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EMAIL_QUEUE=email_queue
RABBITMQ_PREFETCH=10
RABBITMQ_FALLBACK_TO_DIRECT=true

#USER JWT
JWT_SALT=your_jwt_salt_here
JWT_EXPIRES=1d
JWT_REFRESH_SALT=your_jwt_refresh_salt_here
JWT_REFRESH_TOKEN_EXPIRES=10d

# Email configuration
EMAIL_NAME=Your_App_Name
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="your_app_password"
EMAIL_SERVICE=gmail
IS_EMAIL_SEND=1
