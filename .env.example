#@app
APP_ENV=development
APP_NAME=action-arena-gamezone-api
APP_TIMEZONE=Asia/Kolkata

#BACKEND
BACKEND_PROTOCOL=http
BACKEND_HOST=localhost
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000

#FRONTEND
FRONTEND_URL=http://localhost:5173

# WhatsApp contact verification
WP_BASE_URL=https://your-wp-api.example.com
WP_SESSION_ID=your_session_id
WP_API_KEY=your_wp_api_key
WP_BOOKING_TEMPLATE_ID=your_booking_confirmation_template_id

# Public QR scanner endpoint authentication
QR_VERIFY_API_KEY=your_secure_qr_verification_api_key

# Database configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=ActionArenaGamezone
DB_LOG_LEVEL="simple-console" #"advanced-console" | "simple-console" | "file" | "debug"

# Redis configuration
REDIS_URL=redis://localhost:6379

# RabbitMQ configuration
RABBITMQ_ENABLED=1
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EMAIL_QUEUE=email_queue
RABBITMQ_WHATSAPP_QUEUE=whatsapp_booking_queue
RABBITMQ_PREFETCH=10
RABBITMQ_FALLBACK_TO_DIRECT=true
RABBITMQ_FALLBACK_TO_DIRECT_WHATSAPP=true
RABBITMQ_WHATSAPP_MAX_RETRIES=3

#USER JWT
JWT_SALT=your_jwt_salt_here
JWT_EXPIRES=1d
JWT_REFRESH_SALT=your_jwt_refresh_salt_here
JWT_REFRESH_TOKEN_EXPIRES=10d
JWT_SALT_FOR_EMAIL_VERIFICATION_AND_FORGOT_PASSWORD=your_email_verification_salt_here

# Email configuration
EMAIL_NAME=Your_App_Name
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="your_app_password"
EMAIL_SERVICE=gmail
IS_EMAIL_SEND=1

# Admin notifications (contact us, party inquiries)
ADMIN_EMAIL=admin@example.com

# Razorpay configuration
# REQUIRED: Get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# OPTIONAL: Only needed if you want to use webhooks (not required for basic integration)
# Leave commented out if you're not using webhooks
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# QR Code Encryption
QR_ENCRYPTION_KEY=your_qr_encryption_key_here

# Cron Job Configuration
# true = cron runs automatically at 1:00 AM daily | false = disabled (use manual trigger only)
ENABLE_SLOT_GENERATION_CRON=true

# true = cron runs every 2 minutes to release expired locks | false = disabled
ENABLE_SLOT_LOCK_EXPIRY_CRON=true

# true = cron runs every 1 minute to expire unpaid bookings | false = disabled
ENABLE_BOOKING_EXPIRY_CRON=true
